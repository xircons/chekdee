PORT=8080
APP_ENV=development
# Owner/superuser connection — migrations, seedowner, integration tests only.
DATABASE_URL=postgres://checkdee:checkdee@localhost:5432/checkdee?sslmode=disable
# Least-privilege connection the running server uses for its own pool
# (checkdee_app, created by migration 000005 — only SELECT+INSERT on
# admin_audit_logs, ordinary CRUD elsewhere).
APP_DATABASE_URL=postgres://checkdee_app:checkdee-app-dev-only-change-me@localhost:5432/checkdee?sslmode=disable
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# Comma-separated CORS allow-list for browser clients (defaults to the dev frontend).
CORS_ALLOWED_ORIGINS=http://localhost:3000

GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
